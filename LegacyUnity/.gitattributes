# Keep text files normalized.
* text=auto

# Unity text assets should stay merge-friendly.
*.cs text diff=csharp
*.shader text
*.cginc text
*.hlsl text
*.uxml text
*.uss text
*.asmdef text
*.asmref text
*.inputactions text
*.unity text
*.prefab text
*.asset text
*.mat text
*.meta text

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.psd binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
